{
  "name": "@w3-io/action-lint",
  "version": "1.0.0",
  "description": "Deterministic standards linter for W3 partner action repos",
  "type": "module",
  "bin": {
    "action-lint": "dist/src/index.js"
  },
  "main": "dist/src/runner.js",
  "types": "dist/src/runner.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/runner.d.ts",
      "default": "./dist/src/runner.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test dist/test/**/*.test.js",
    "all": "npm run format && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.1"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/w3-io/action-lint.git"
  },
  "license": "GPL-3.0-only"
}
